@page
@model GregPay.WebApp.Pages.IndexModel
@{
    ViewData["Title"] = "Lista de Funcionários";
}

<!-- Estilos para o layout do PDF -->
<style>
    .page-container {
        max-width: 1000px;
        margin: auto;
    }
    .filter-section {
        display: flex;
        gap: 15px;
        align-items: flex-end;
        padding: 15px;
        border: 1px solid #ccc;
        border-radius: 8px;
        margin-bottom: 20px;
    }
    .filter-group {
        display: flex;
        flex-direction: column;
    }
    .form-control {
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }
    .table-main {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 20px;
    }
    .table-main th, .table-main td {
        border: 1px solid #dee2e6;
        padding: 12px;
        text-align: left;
        vertical-align: middle;
    }
    .table-main th {
        background-color: #343a40;
        color: white;
    }
    .table-main tr:nth-child(even) {
        background-color: #f8f9fa;
    }

    /* --- ESTILOS DOS BOTÕES --- */
    .btn {
        padding: 10px 15px;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        font-size: 1rem;
        margin-right: 5px;
    }
    .btn-primary { background-color: #0d6efd; color: white; }
    
    /* Botões pequenos para a tabela */
    .btn-sm { 
        padding: 5px 10px; 
        font-size: 0.8em; 
        text-decoration: none;
    }
    .btn-warning { background-color: #ffc107; color: #000; }
    .btn-danger { background-color: #dc3545; color: white; }
    /* --- FIM DOS ESTILOS --- */
</style>

<div class="page-container">
    <h3>Sistema de Teste</h3>

    <!-- O formulário de filtro -->
    <div class="filter-section">
        <form method="get" class="d-flex" style="width:100%; display:flex; gap: 15px; align-items: flex-end;">
            <div class="filter-group">
                <label asp-for="Nome">Nome:</label>
                <input asp-for="Nome" class="form-control" />
            </div>
            <div class="filter-group">
                <label asp-for="Departamento">Departamento:</label>
                <input asp-for="Departamento" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Pesquisar</button>
        </form>
    </div>

    <!-- A tabela de funcionários -->
    <table class="table-main">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Departamento</th>
                <th>Salário</th>
                <th>Data Nascimento</th>
                <th>Num. Filhos</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Funcionarios != null && Model.Funcionarios.Any())
            {
                foreach (var func in Model.Funcionarios)
                {
                    <tr>
                        <td>@func.Nome</td>
                        <td>@func.Departamento</td>
                        <td>@func.Salario.ToString("C")</td>
                        <td>@func.DataNascimento.ToString("dd/MM/yyyy")</td>
                        <td>@func.Filhos.Count</td>
                        <td>
                            <!-- ⬇️ CORREÇÃO DOS BOTÕES AQUI ⬇️ -->
                            <a asp-page="./Edit" asp-route-id="@func.Id" class="btn btn-warning btn-sm">Editar</a>
                            <a asp-page="./Delete" asp-route-id="@func.Id" class="btn btn-danger btn-sm">Excluir</a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" style="text-align:center;">Nenhum funcionário encontrado.</td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-page="./Create" class="btn btn-primary">Novo funcionário</a>
</div>

