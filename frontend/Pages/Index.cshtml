@page
@model GregPay.WebApp.Pages.IndexModel
@{
    ViewData["Title"] = "Sistema de Teste";
}

<!-- Adiciona um pouco de CSS para se parecer com o esboço -->
<style>
    .filter-section, .table-section {
        border: 1px solid #ccc;
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 20px;
    }
    .filter-grid {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 15px;
        align-items: flex-end;
    }
    .form-group {
        display: flex;
        flex-direction: column;
    }
    .form-control {
        padding: 8px;
        border: 1px solid #ccc;
        border-radius: 4px;
    }
    .btn {
        padding: 10px 15px;
        border-radius: 4px;
        border: none;
        cursor: pointer;
        text-decoration: none;
        display: inline-block;
        text-align: center;
    }
    .btn-primary { background-color: #0d6efd; color: white; }
    .btn-secondary { background-color: #6c757d; color: white; }
    .btn-sm { padding: 5px 10px; font-size: 0.875rem; }
    .btn-danger { background-color: #dc3545; color: white; }
</style>

<h3>Sistema de Teste</h3>

<!-- Seção de Filtros (conforme PDF) -->
<div class="filter-section">
    <form method="get">
        <div class="filter-grid">
            <div class="form-group">
                <label asp-for="FiltroNome">Nome:</label>
                <input asp-for="FiltroNome" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="FiltroDepartamento">Departamento:</label>
                <!-- O PDF mostra um dropdown, mas um input é mais simples para o filtro da API -->
                <input asp-for="FiltroDepartamento" class="form-control" />
            </div>
            <button type="submit" class="btn btn-primary">Pesquisar</button>
        </div>
    </form>
</div>

<!-- Seção da Tabela (conforme PDF) -->
<div class="table-section">
    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Nome</th>
                <th>Departamento</th>
                <th>Salário</th>
                <th>Data Nascimento</th>
                <th>Num. Filhos</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var func in Model.Funcionarios)
            {
                <tr>
                    <td>@func.Nome</td>
                    <td>@func.Departamento</td>
                    <td>@func.Salario.ToString("C")</td>
                    <td>@func.DataNascimento.ToString("dd/MM/yyyy")</td>
                    <td>@func.Filhos.Count</td>
                    <td>
                        <a asp-page="/Edit" asp-route-id="@func.Id" class="btn btn-sm btn-secondary">editar</a>
                        <a asp-page="/Delete" asp-route-id="@func.Id" class="btn btn-sm btn-danger">excluir</a>
                    </td>
                </tr>
            }
            @if (!Model.Funcionarios.Any())
            {
                <tr>
                    <td colspan="6" class="text-center">Nenhum funcionário encontrado.</td>
                </tr>
            }
        </tbody>
    </table>

    <hr />
    <!-- Botão "Novo funcionário" (conforme PDF) -->
    <a asp-page="/Create" class="btn btn-primary">Novo funcionário</a>
</div>
